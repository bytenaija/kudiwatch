# Local dev only — fake values. NEVER put real credentials here.
# Copy to .dev.vars for `wrangler dev` (the Node local server reads env directly).
JWT_SECRET=dev-jwt-secret-change-me
WATCH_TOKEN_SECRET=dev-watch-secret-change-me
OTP_PEPPER=dev-otp-pepper-change-me
ENV_NAME=local
# Optional: R2 S3-compatible credentials for REAL presigned uploads in prod.
# Local dev uses an HMAC-signed local upload shim instead.
# R2_S3_ENDPOINT=
# R2_S3_ACCESS_KEY_ID=
# R2_S3_SECRET_ACCESS_KEY=
# R2_S3_BUCKET=kw-videos
